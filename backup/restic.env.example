# Copy to /etc/dapex-game-backup.env, edit as root, then chmod 0600.
# Never commit the real file or the referenced password/credential files.

# Restic supports local paths, SFTP, REST servers, S3-compatible storage, and
# cloud providers. Examples:
# RESTIC_REPOSITORY=/mnt/offsite/dapex-game-server
# RESTIC_REPOSITORY=sftp:backup@example.net:/srv/restic/dapex-game-server
# RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/dapex-game-server
RESTIC_REPOSITORY=

# Store a long random password in this root-owned file (mode 0600).
RESTIC_PASSWORD_FILE=/etc/dapex-game-backup.password

# Required only for S3-compatible repositories such as Cloudflare R2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# Optional provider-specific variables, for example:
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=

# Retention is applied only by the separate prune service/timer.
RESTIC_KEEP_DAILY=4
RESTIC_KEEP_WEEKLY=2
RESTIC_KEEP_MONTHLY=2
RESTIC_KEEP_YEARLY=1

# Keep R2 below the 10 GB-month Standard free tier with room for repository
# metadata and billing-unit differences. Oldest snapshots are pruned first,
# but the newest two are always protected even if a single world grows large.
RESTIC_MAX_REPOSITORY_BYTES=7516192768
RESTIC_MIN_SNAPSHOTS=2

# Keep the newly-created tarballs after a successful off-host snapshot.
# By default they are deleted after upload; restic remains the durable copy.
KEEP_LOCAL_ARCHIVES=false
