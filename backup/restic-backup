#!/usr/bin/env bash
set -euo pipefail

root=${BACKUP_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
restic_bin=${RESTIC_BIN:-restic}
offsite_lock=${OFFSITE_BACKUP_LOCK:-$root/.offsite-backup.lock}
valheim_backup=${VALHEIM_BACKUP_COMMAND:-$root/scripts/backup.sh}
minecraft_backup=${MINECRAFT_BACKUP_COMMAND:-$root/scripts/backup-minecraft.sh}

die() { printf 'offsite-backup: %s\n' "$*" >&2; exit 1; }
need_config() {
  [[ -n ${RESTIC_REPOSITORY:-} ]] || die 'RESTIC_REPOSITORY is not set'
  if [[ -n ${RESTIC_PASSWORD_FILE:-} ]]; then
    [[ -r $RESTIC_PASSWORD_FILE ]] || die "password file is not readable: $RESTIC_PASSWORD_FILE"
  elif [[ -z ${RESTIC_PASSWORD:-} ]]; then
    die 'set RESTIC_PASSWORD_FILE (recommended) or RESTIC_PASSWORD'
  fi
  command -v "$restic_bin" >/dev/null 2>&1 || die "restic executable not found: $restic_bin"
}
run_restic() { "$restic_bin" "$@"; }
apply_retention() {
  run_restic forget --prune \
    --tag dapex-game-server \
    --keep-daily "${RESTIC_KEEP_DAILY:-4}" \
    --keep-weekly "${RESTIC_KEEP_WEEKLY:-2}" \
    --keep-monthly "${RESTIC_KEEP_MONTHLY:-2}" \
    --keep-yearly "${RESTIC_KEEP_YEARLY:-1}"
}
enforce_repository_limit() {
  local max_bytes=${RESTIC_MAX_REPOSITORY_BYTES:-7516192768}
  local minimum_snapshots=${RESTIC_MIN_SNAPSHOTS:-2}
  [[ $max_bytes =~ ^[0-9]+$ && $max_bytes -gt 0 ]] || die 'RESTIC_MAX_REPOSITORY_BYTES must be a positive integer'
  [[ $minimum_snapshots =~ ^[0-9]+$ && $minimum_snapshots -ge 1 ]] || die 'RESTIC_MIN_SNAPSHOTS must be a positive integer'
  command -v jq >/dev/null 2>&1 || die 'jq is required to enforce the repository size budget'

  local attempts=0 stats size snapshots count oldest
  while (( attempts < 100 )); do
    stats=$(run_restic stats --mode raw-data --json --tag dapex-game-server)
    size=$(jq -er '.total_size | numbers' <<<"$stats") || die 'could not read repository size from restic stats'
    if (( size <= max_bytes )); then
      printf 'offsite-backup: repository uses %s of %s bytes\n' "$size" "$max_bytes"
      return
    fi

    snapshots=$(run_restic snapshots --json --tag dapex-game-server)
    count=$(jq -er 'length' <<<"$snapshots") || die 'could not count restic snapshots'
    if (( count <= minimum_snapshots )); then
      die "repository uses $size bytes, above the $max_bytes byte budget, but the newest $minimum_snapshots snapshots are protected"
    fi
    oldest=$(jq -er 'sort_by(.time) | .[0].id' <<<"$snapshots") || die 'could not select the oldest restic snapshot'
    printf 'offsite-backup: pruning oldest snapshot %s to enforce %s byte budget\n' "${oldest:0:8}" "$max_bytes"
    run_restic forget --prune "$oldest"
    attempts=$((attempts + 1))
  done
  die 'repository size budget could not be reached after 100 prune attempts'
}

command=${1:-backup}
case "$command" in
  init)
    need_config
    run_restic init
    ;;
  backup)
    need_config
    command -v flock >/dev/null 2>&1 || die 'flock is required'
    mkdir -p "$(dirname "$offsite_lock")"
    exec 9>"$offsite_lock"
    flock -n 9 || die 'another off-host backup is already running'

    created=()
    upload_succeeded=false
    cleanup() {
      if [[ $upload_succeeded == true && ${KEEP_LOCAL_ARCHIVES:-false} != true ]]; then
        for archive in "${created[@]:-}"; do
          [[ -n $archive && -f $archive ]] && rm -f -- "$archive"
        done
      fi
    }
    trap cleanup EXIT INT TERM

    cd "$root"
    valheim_archive=$("$valheim_backup")
    [[ -f $valheim_archive ]] || die "Valheim backup did not create: $valheim_archive"
    created+=("$valheim_archive")

    minecraft_archive=$("$minecraft_backup")
    [[ -f $minecraft_archive ]] || die "Minecraft backup did not create: $minecraft_archive"
    created+=("$minecraft_archive")

    run_restic backup \
      --tag dapex-game-server \
      --tag consistent-game-archives \
      --host "${RESTIC_HOST:-$(hostname -s)}" \
      -- "$valheim_archive" "$minecraft_archive"
    upload_succeeded=true
    ;;
  forget)
    need_config
    apply_retention
    ;;
  enforce-limit)
    need_config
    enforce_repository_limit
    ;;
  check)
    need_config
    run_restic check --read-data-subset="${RESTIC_CHECK_SUBSET:-5%}"
    ;;
  snapshots)
    need_config
    run_restic snapshots --tag dapex-game-server
    ;;
  *)
    die 'usage: restic-backup {init|backup|forget|enforce-limit|check|snapshots}'
    ;;
esac
