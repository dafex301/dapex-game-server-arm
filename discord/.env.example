# Obtain this secret from the Discord Developer Portal. Never commit it.
DISCORD_BOT_TOKEN=

# Enable Developer Mode in Discord, then right-click the server/channel/role.
DISCORD_GUILD_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# Optional settings (defaults shown).
VALHEIM_DEPLOY_DIR=/home/ubuntu/valheim-server-arm
VALHEIM_CONTAINER=valheim
STATUS_POLL_SECONDS=30
COMMAND_COOLDOWN_SECONDS=180
STATUS_STATE_FILE=./state.json

# Optional authoritative lifecycle state produced by monitoring/valheim-watchdog.
WATCHDOG_STATE_FILE=/var/lib/valheim-watchdog/state.json
WATCHDOG_MAX_AGE_SECONDS=180
